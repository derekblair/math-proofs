\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The sliding shadow window of Theorem~\ref {thm:march} for $A^\star $ near the bottom edge ($[1,184]\subseteq W(A^\star )$ by saturation, so cells $1,2$ are filled). As $t$ grows, the test window $[1-t,0]$ slides left through the fixed shadow; each gap it frames becomes a hole at $g+t$. The fixed gap $-1$ generates the traveling hole $\{1\},\{2\},\{3\}$ at $t=2,3,4$; the deeper gaps $-4,-5$ enter at $t=5,6$. Shadow membership is [COMPUTED] $\times 2$; the hole values are forced by~\eqref  {eq:marchpos}.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:window}{{1}{4}{The sliding shadow window of Theorem~\ref {thm:march} for $A^\star $ near the bottom edge ($[1,184]\subseteq W(A^\star )$ by saturation, so cells $1,2$ are filled). As $t$ grows, the test window $[1-t,0]$ slides left through the fixed shadow; each gap it frames becomes a hole at $g+t$. The fixed gap $-1$ generates the traveling hole $\{1\},\{2\},\{3\}$ at $t=2,3,4$; the deeper gaps $-4,-5$ enter at $t=5,6$. Shadow membership is [COMPUTED] $\times 2$; the hole values are forced by~\eqref {eq:marchpos}}{figure.1}{}}
