\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Digit-compatibility failure at $169=13^2$ [COMPUTED, from R185]: the inverse pair $(8,5)$ has equal-size digit sets $S_8=[0,1,4,9,11]$, $S_5=[0,1,3,4,11]$, but $A_8(S_8)=[2,7,9,11,12] \ne  S_5$. The violator $(5,34)$: $34=8+13\cdot 2$ needs $2=A_5(0)\notin  S_8$. This is a genuine digit mismatch, not fiber-size asymmetry.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:mismatch}{{1}{6}{Digit-compatibility failure at $169=13^2$ [COMPUTED, from R185]: the inverse pair $(8,5)$ has equal-size digit sets $S_8=[0,1,4,9,11]$, $S_5=[0,1,3,4,11]$, but $A_8(S_8)=[2,7,9,11,12] \ne S_5$. The violator $(5,34)$: $34=8+13\cdot 2$ needs $2=A_5(0)\notin S_8$. This is a genuine digit mismatch, not fiber-size asymmetry}{figure.1}{}}
