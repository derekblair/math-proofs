\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The constructive witness of \url  {dichotomy_two_margins}: two non-singleton margins $U_i=\{a,b\}$, $U_j=\{c,d\}$ admit two \emph  {distinct} full-margin subsets $S_1\ne  S_2$ of $U_i\times U_j$ --- the two diagonals. Two fiber components differing exactly on these diagonals is the hole pattern; with at most one non-singleton margin only the full rectangle exists ($\mathcal  {H}=0$).}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:diagonals}{{1}{5}{The constructive witness of \url {dichotomy_two_margins}: two non-singleton margins $U_i=\{a,b\}$, $U_j=\{c,d\}$ admit two \emph {distinct} full-margin subsets $S_1\ne S_2$ of $U_i\times U_j$ --- the two diagonals. Two fiber components differing exactly on these diagonals is the hole pattern; with at most one non-singleton margin only the full rectangle exists ($\mathcal {H}=0$)}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Modulus suppression index $\bar  \sigma (m)$: fraction of hole-capable pairs with $\sigma =1$ (computed datum, R199~\S  3). Suppression occurs only at these five moduli; all six suppressed pairs are full-rectangle T5 instances (Theorem~\ref {thm:t5}).}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:sigmabar}{{2}{5}{Modulus suppression index $\bar \sigma (m)$: fraction of hole-capable pairs with $\sigma =1$ (computed datum, R199~\S 3). Suppression occurs only at these five moduli; all six suppressed pairs are full-rectangle T5 instances (Theorem~\ref {thm:t5})}{figure.2}{}}
