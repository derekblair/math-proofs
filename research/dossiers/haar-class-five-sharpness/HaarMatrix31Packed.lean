import Mathlib.Data.Nat.Basic

namespace HaarMatrix31Packed

def zero : Array ℕ := Array.replicate 15 0

def xp (x : Array ℕ) : Array ℕ := #[
  (14+x[0]!)%31,
  (0+x[1]!+22*x[0]!)%31,
  (0+x[2]!+19*x[1]!)%31,
  (0+x[3]!+2*x[2]!)%31,
  (0+x[4]!+14*x[3]!)%31,
  (22+x[5]!)%31,
  (0+x[6]!+19*x[5]!)%31,
  (0+x[7]!+2*x[6]!)%31,
  (0+x[8]!+14*x[7]!)%31,
  (19+x[9]!)%31,
  (0+x[10]!+2*x[9]!)%31,
  (0+x[11]!+14*x[10]!)%31,
  (2+x[12]!)%31,
  (0+x[13]!+14*x[12]!)%31,
  (14+x[14]!)%31
]
def yp (x : Array ℕ) : Array ℕ := #[
  (28+x[0]!)%31,
  (0+x[1]!+11*x[0]!)%31,
  (0+x[2]!+15*x[1]!)%31,
  (0+x[3]!+24*x[2]!)%31,
  (0+x[4]!+13*x[3]!)%31,
  (11+x[5]!)%31,
  (0+x[6]!+15*x[5]!)%31,
  (0+x[7]!+24*x[6]!)%31,
  (0+x[8]!+13*x[7]!)%31,
  (15+x[9]!)%31,
  (0+x[10]!+24*x[9]!)%31,
  (0+x[11]!+13*x[10]!)%31,
  (24+x[12]!)%31,
  (0+x[13]!+13*x[12]!)%31,
  (13+x[14]!)%31
]
def xn (x : Array ℕ) : Array ℕ := #[
  (17+x[0]!)%31,
  (29+x[1]!+9*x[0]!)%31,
  (7+x[2]!+15*x[0]!+12*x[1]!)%31,
  (17+x[3]!+1*x[0]!+7*x[1]!+29*x[2]!)%31,
  (10+x[4]!+17*x[0]!+26*x[1]!+28*x[2]!+17*x[3]!)%31,
  (9+x[5]!)%31,
  (15+x[6]!+12*x[5]!)%31,
  (1+x[7]!+7*x[5]!+29*x[6]!)%31,
  (17+x[8]!+26*x[5]!+28*x[6]!+17*x[7]!)%31,
  (12+x[9]!)%31,
  (7+x[10]!+29*x[9]!)%31,
  (26+x[11]!+28*x[9]!+17*x[10]!)%31,
  (29+x[12]!)%31,
  (28+x[13]!+17*x[12]!)%31,
  (17+x[14]!)%31
]
def yn (x : Array ℕ) : Array ℕ := #[
  (3+x[0]!)%31,
  (29+x[1]!+20*x[0]!)%31,
  (30+x[2]!+10*x[0]!+16*x[1]!)%31,
  (24+x[3]!+8*x[0]!+19*x[1]!+7*x[2]!)%31,
  (29+x[4]!+20*x[0]!+1*x[1]!+2*x[2]!+18*x[3]!)%31,
  (20+x[5]!)%31,
  (10+x[6]!+16*x[5]!)%31,
  (8+x[7]!+19*x[5]!+7*x[6]!)%31,
  (20+x[8]!+1*x[5]!+2*x[6]!+18*x[7]!)%31,
  (16+x[9]!)%31,
  (19+x[10]!+7*x[9]!)%31,
  (1+x[11]!+2*x[9]!+18*x[10]!)%31,
  (7+x[12]!)%31,
  (2+x[13]!+18*x[12]!)%31,
  (18+x[14]!)%31
]

def move (pos : Bool) (port : ℕ) (a : Array ℕ) : Array ℕ :=
  if port=0 then a else
  if port=1 then (if pos then xp a else xn a) else (if pos then yp a else yn a)

def key (a : Array ℕ) : ℕ := a.toList.foldl (fun n b => 31*n+b) 0

def words (a : Array ℕ) (pos : Bool) (last : ℕ) : ℕ → List ℕ
  | 0 => [key a]
  | n+1 => [0,1,2].flatMap fun j => if j=last then [] else words (move pos j a) (!pos) j n

def strict : List ℕ → Bool
  | [] => true
  | [_] => true
  | a::b::l => (a < b) && strict (b::l)

def census (n : ℕ) : ℕ × Bool :=
  let keys := words zero true 3 n
  (keys.length, strict (keys.mergeSort (·≤·)))

end HaarMatrix31Packed
