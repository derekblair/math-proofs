private def lookup0 (k : ℕ) : ℕ :=
  let h := mix k 6
  let b := h &&& 32767
  let off := (offset0 (b/1024) >>> (8*(b%1024))) &&& 255
  let j := ((h >>> 15)+off) &&& 131071
  (owners0 (j/4096) >>> (2*(j%4096))) &&& 3

