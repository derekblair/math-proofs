private def lookup1 (k : ℕ) : ℕ :=
  let h := mix k 1
  let b := h &&& 32767
  let off := (offset1 (b/1024) >>> (8*(b%1024))) &&& 255
  let j := ((h >>> 15)+off) &&& 131071
  (owners1 (j/4096) >>> (2*(j%4096))) &&& 3

/-- Candidate port owner. Soundness never assumes this hash
is injective: the designated owner of every endpoint is checked. -/
def owner (rootSide : Bool) (key : ℕ) : ℕ :=
  if rootSide then lookup1 key else lookup0 key

