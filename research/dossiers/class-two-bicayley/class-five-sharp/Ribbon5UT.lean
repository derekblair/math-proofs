def row (i : Fin 64) : Mat := upperize (unflatten rows[i.val]!)
def keyMat (A : Mat) : Nat := (project A).toList.foldl (fun x y => 17*x+y) 0

private theorem rows_band : ∀ i : Fin 64, Band 1 (row i-1) := fun _ => band_upperize _

noncomputable def vertex (i : Fin 64) : V := (sides i,ofMatrix (row i) (rows_band i))
private theorem val_vertex (i : Fin 64) : value (vertex i).2=row i := value_ofMatrix _ (rows_band i)

private theorem code_rows : ∀ i : Fin 64, keyMat (row i)=codes[i.val]! := by decide +kernel
private theorem no_code_clash : ∀ i j : Fin 64, sides i=sides j →
    codes[i.val]! = codes[j.val]! → i=j := by decide +kernel

def next (i : Fin 64) : Fin 64 := ⟨(i.val+1)%64,Nat.mod_lt _ (by decide)⟩

private theorem data_adj : ∀ i : Fin 64,
    if word i=2 then sides i≠sides (next i) ∧ row i=row (next i)
    else sides i=sides (next i) ∧
      (if sides i then
        (if word i=0 then row i*rawB=row (next i) else row (next i)*rawB=row i)
       else
        (if word i=0 then row i*rawA=row (next i) else row (next i)*rawA=row i)) :=
  by decide +kernel

theorem cycle64 : Ribbon.Cycle a b 64 := by
  refine ⟨vertex,?_,fun i => ?_⟩
  · intro i j eq
    have xy := congrArg (fun v : V => value v.2) eq
    change value (vertex i).2=value (vertex j).2 at xy
    rw [val_vertex,val_vertex] at xy
    apply no_code_clash i j (congrArg Prod.fst eq)
    rw [←code_rows,←code_rows,xy]
  · change Ribbon.Adj a b (vertex i) (vertex (next i))
    have h := data_adj i
    by_cases q : word i=2
    · rw [ite_eq_left q] at h
      exact Or.inr (Or.inr ⟨h.1,value_inj (by simpa only [val_vertex] using h.2)⟩)
    rw [ite_eq_right q] at h
    by_cases S : sides i
    · have T : sides (next i)=true := h.1.symm.trans S
      have e := h.2
      rw [ite_eq_left S] at e
      refine Or.inr (Or.inl ⟨S,T,?_⟩)
      by_cases w : word i=0
      · rw [ite_eq_left w] at e
        exact Or.inl (value_inj (by simpa only [value_mul,val_vertex,val_b] using e))
      · rw [ite_eq_right w] at e
        exact Or.inr (value_inj (by simpa only [value_mul,val_vertex,val_b] using e))
    · have S' : sides i=false := by simpa using S
      have T : sides (next i)=false := h.1.symm.trans S'
      have e := h.2
      rw [ite_eq_right S] at e
      refine Or.inl ⟨S',T,?_⟩
      by_cases w : word i=0
      · rw [ite_eq_left w] at e
        exact Or.inl (value_inj (by simpa only [value_mul,val_vertex,val_a] using e))
      · rw [ite_eq_right w] at e
        exact Or.inr (value_inj (by simpa only [value_mul,val_vertex,val_a] using e))

end Ribbon5UT
