import Mathlib.Data.Fin.VecNotation

namespace Ribbon5Packed

abbrev State := Bool × Array Nat

def zero (b : Bool) : State := (b,Array.replicate 15 0)

def aPos (a : Array Nat) : Array Nat := #[
    (4 + a[0]!)%17,
    (0 + a[1]! + 4*a[0]!)%17,
    (0 + a[2]! + 4*a[1]!)%17,
    (0 + a[3]! + 10*a[2]!)%17,
    (0 + a[4]! + 7*a[3]!)%17,
    (4 + a[5]!)%17,
    (0 + a[6]! + 4*a[5]!)%17,
    (0 + a[7]! + 10*a[6]!)%17,
    (0 + a[8]! + 7*a[7]!)%17,
    (4 + a[9]!)%17,
    (0 + a[10]! + 10*a[9]!)%17,
    (0 + a[11]! + 7*a[10]!)%17,
    (10 + a[12]!)%17,
    (0 + a[13]! + 7*a[12]!)%17,
    (7 + a[14]!)%17
]

def aNeg (a : Array Nat) : Array Nat := #[
    (13 + a[0]!)%17,
    (16 + a[1]! + 13*a[0]!)%17,
    (4 + a[2]! + 16*a[0]! + 13*a[1]!)%17,
    (11 + a[3]! + 10*a[0]! + 6*a[1]! + 7*a[2]!)%17,
    (8 + a[4]! + 15*a[0]! + 9*a[1]! + 2*a[2]! + 10*a[3]!)%17,
    (13 + a[5]!)%17,
    (16 + a[6]! + 13*a[5]!)%17,
    (10 + a[7]! + 6*a[5]! + 7*a[6]!)%17,
    (15 + a[8]! + 9*a[5]! + 2*a[6]! + 10*a[7]!)%17,
    (13 + a[9]!)%17,
    (6 + a[10]! + 7*a[9]!)%17,
    (9 + a[11]! + 2*a[9]! + 10*a[10]!)%17,
    (7 + a[12]!)%17,
    (2 + a[13]! + 10*a[12]!)%17,
    (10 + a[14]!)%17
]

def bPos (a : Array Nat) : Array Nat := #[
    (12 + a[0]!)%17,
    (0 + a[1]! + 12*a[0]!)%17,
    (0 + a[2]! + 9*a[1]!)%17,
    (0 + a[3]! + 12*a[2]!)%17,
    (0 + a[4]! + 2*a[3]!)%17,
    (12 + a[5]!)%17,
    (0 + a[6]! + 9*a[5]!)%17,
    (0 + a[7]! + 12*a[6]!)%17,
    (0 + a[8]! + 2*a[7]!)%17,
    (9 + a[9]!)%17,
    (0 + a[10]! + 12*a[9]!)%17,
    (0 + a[11]! + 2*a[10]!)%17,
    (12 + a[12]!)%17,
    (0 + a[13]! + 2*a[12]!)%17,
    (2 + a[14]!)%17
]

def bNeg (a : Array Nat) : Array Nat := #[
    (5 + a[0]!)%17,
    (8 + a[1]! + 5*a[0]!)%17,
    (13 + a[2]! + 6*a[0]! + 8*a[1]!)%17,
    (14 + a[3]! + 13*a[0]! + 6*a[1]! + 5*a[2]!)%17,
    (6 + a[4]! + 8*a[0]! + 5*a[1]! + 7*a[2]! + 15*a[3]!)%17,
    (5 + a[5]!)%17,
    (6 + a[6]! + 8*a[5]!)%17,
    (13 + a[7]! + 6*a[5]! + 5*a[6]!)%17,
    (8 + a[8]! + 5*a[5]! + 7*a[6]! + 15*a[7]!)%17,
    (8 + a[9]!)%17,
    (6 + a[10]! + 5*a[9]!)%17,
    (5 + a[11]! + 7*a[9]! + 15*a[10]!)%17,
    (5 + a[12]!)%17,
    (7 + a[13]! + 15*a[12]!)%17,
    (15 + a[14]!)%17
]


def step (s : State) (j : Fin 3) : State :=
  if j=2 then (!s.1,s.2)
  else (s.1,if s.1 then (if j=0 then bPos s.2 else bNeg s.2)
    else (if j=0 then aPos s.2 else aNeg s.2))

def back (j : Fin 3) : Fin 3 := ![1,0,2] j

def key (s : State) : Nat := s.2.toList.foldl (fun n b => 17*n+b) (if s.1 then 1 else 0)

def ends : Nat → State → Fin 3 → List Nat
  | 0, s, _ => [key s]
  | n+1, s, prev => ([0,1,2] : List (Fin 3)).flatMap fun j =>
      if j=back prev then [] else ends n (step s j) j

end Ribbon5Packed
