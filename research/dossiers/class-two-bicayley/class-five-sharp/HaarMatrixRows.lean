def getRow (i : Fin 64) : Mat := unflatten rows[i.val]!

def matCode (A : Mat) : ℕ :=
  ((List.finRange 6).flatMap fun i => (List.finRange 6).map fun j => (A i j).val).foldl (fun a b => a*17+b) 0

theorem gen_band : Band 1 (rawX-1) ∧ Band 1 (rawY-1) := by
  constructor <;> intro i j <;> revert i j <;> decide

set_option maxRecDepth 20000 in
set_option maxHeartbeats 2000000 in
theorem row_band (i : Fin 64) : Band 1 (getRow i-1) := by
  intro a b
  revert i a b
  decide

set_option maxRecDepth 18000 in
set_option maxHeartbeats 3000000 in
theorem code_rows (i : Fin 64) : matCode (getRow i)=codes[i.val]! := by
  revert i
  decide

def side (i : Fin 64) : Bool := decide (i.val%2=1)

def rel (a b : Mat) : Prop := b=a ∨ b=a*rawX ∨ b=a*rawY
instance (a b : Mat) : Decidable (rel a b) := by unfold rel; infer_instance

def step (i : Fin 64) : Prop :=
  if side i then rel (getRow (i+1)) (getRow i) else rel (getRow i) (getRow (i+1))
instance (i : Fin 64) : Decidable (step i) := by unfold step; infer_instance

set_option maxRecDepth 20000 in
set_option maxHeartbeats 4000000 in
theorem exact_step (i : Fin 64) : step i := by
  revert i
  decide

theorem side_step (i : Fin 64) : side i ≠ side (i+1) := by
  revert i
  decide

set_option maxRecDepth 18000 in
set_option maxHeartbeats 2000000 in
theorem code_separates (i j : Fin 64) :
    i=j ∨ side i ≠ side j ∨ codes[i.val]! ≠ codes[j.val]! := by
  revert i j
  decide

end HaarMatrixRows

#print axioms HaarMatrixRows.exact_step
#print axioms HaarMatrixRows.code_separates
