def r (t : Fin 3) (i : ℕ) : Row := (T t)[i]!
theorem len (t : Fin 3) : (W t).length = 64 := by revert t; decide
theorem start (t : Fin 3) : r t 0=base := by revert t; decide
theorem step (t : Fin 3) (i : ℕ) (hi : i<(W t).length) :
    (label (W t) i=2 → range4 (r t i).i) ∧
      r t (i+1)=move (decide (i%2=0)) (label (W t) i) (r t i) := by
  have h : ∀ (t : Fin 3) (i : Fin 64), (label (W t) i.val=2 → range4 (r t i.val).i) ∧
    r t (i.val+1)=move (decide (i.val%2=0)) (label (W t) i.val) (r t i.val) := by
    decide +kernel
  rw [len] at hi
  exact h t ⟨i,hi⟩

def lo : Fin 3 → ℕ := ![14,13,12]
def midpt : Fin 3 → ℕ := ![16,14,12]
def hi : Fin 3 → ℕ := ![18,17,16]
def bSmall (k : ℤ) : Prop := -2≤k ∧ k≤2
def cSmall (k : ℤ) : Prop := -3≤k ∧ k≤3
def dir (t : Fin 3) (d : Row) : ℤ := if t=0 then d.v else if t=1 then d.v else d.u
def pairs (t : Fin 3) (i j : Fin 64) : Prop :=
  let D := diff (r t i.val) (r t j.val)
  let k := dir t D
  bSmall D.i ∧ bSmall D.j ∧
  (i.val<j.val → i.val%2=j.val%2 → D.i=0 → D.j=0 →
    cSmall D.c ∧ (D.c=0 → bSmall k ∧
      D.u=(if t=0 then 0 else if t=1 then -k else k) ∧
      D.v=(if t=2 then 0 else k) ∧
      (k=0 → lo t≤ i.val ∧ i.val≤hi t ∧ j.val=i.val+32)))
instance (t : Fin 3) (i j : Fin 64) : Decidable (pairs t i j) := by
  unfold pairs bSmall cSmall
  infer_instance

