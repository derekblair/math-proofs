def row (w : Fin 3) (n : ℕ) : Row := (allRows w)[n]!
theorem len (w : Fin 3) : (W w).length=64 := by revert w; decide
theorem zero (w : Fin 3) : row w 0=base := by revert w; decide
theorem steps (w : Fin 3) (i : Fin 64) :
    (label (W w) i.val=2 → range4 (row w i.val).i) ∧
      row w (i.val+1)=move (decide (i.val%2=0)) (label (W w) i.val) (row w i.val) := by
  revert w i
  decide

def tail (p : Row) : Coeff := (p.u,p.v,p.a,p.b,p.d)

def pair_valid (w : Fin 3) (i j : Fin 64) : Prop :=
  let D := HaarClass4Table.diff (row w i.val) (row w j.val)
  j.val ≤ i.val ∨ i.val%2≠j.val%2 ∨ D.i%3≠0 ∨ D.j%3≠0 ∨
    (D.i=0 ∧ D.j=0 ∧ D.c%3≠0) ∨
    (D.i=0 ∧ D.j=0 ∧ D.c=0 ∧ tail D ∈ critical w)
instance (w : Fin 3) (i j : Fin 64) : Decidable (pair_valid w i j) := by unfold pair_valid; infer_instance

set_option maxRecDepth 16000 in
set_option maxHeartbeats 2000000 in
theorem all_pairs (w : Fin 3) (i j : Fin 64) : pair_valid w i j := by
  revert w i j
  decide +kernel

def accepted (w : Fin 3) (axis : Fin 4) (offset carry : Fin 3) : Bool :=
  (critical w).all fun a => decide (lead axis a %3 ≠ 0 ∨ rem4 axis offset carry a %3 ≠ 0)

theorem cover : ∀ (axis : Fin 4) (offset carry : Fin 3),
    ∃ w : Fin 3, accepted w axis offset carry=true := by decide +kernel

end HaarClass6RankOneCert
#print axioms HaarClass6RankOneCert.all_pairs
