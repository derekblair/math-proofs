import RibbonIA

namespace RibbonSchreierCollect
open scoped commutatorElement
variable {G : Type*} [Group G]

/-- Every commutator is central. We use this in D/γ₃(D), rather than
assuming the ambient group generated by the two rim ports is class two. -/
def Central₂ (G : Type*) [Group G] : Prop :=
  ∀ u v w : G, Commute ⁅u,v⁆ w

abbrev Letter := Nat × Bool
abbrev Com := (Nat × Nat) × Bool

def sgn (u : G) (pos : Bool) : G := if pos then u else u⁻¹

def ls (g : Nat → G) (x : Letter) : G := sgn (g x.1) x.2
def cs (g : Nat → G) (x : Com) : G := sgn ⁅g x.1.1,g x.1.2⁆ x.2

def evalL (g : Nat → G) (w : List Letter) : G := (w.map (ls g)).prod
def evalC (g : Nat → G) (w : List Com) : G := (w.map (cs g)).prod

theorem inv_left (c : Central₂ G) (u v : G) : ⁅u⁻¹,v⁆=⁅u,v⁆⁻¹ := by
  rw [commutatorElement_inv_left]
  have h := (c u v u).inv_left.symm.inv_left.eq
  rw [←commutatorElement_inv, h, mul_assoc, inv_mul_cancel, mul_one]

theorem inv_right (c : Central₂ G) (u v : G) : ⁅u,v⁻¹⁆=⁅u,v⁆⁻¹ := by
  rw [←commutatorElement_inv, inv_left c, commutatorElement_inv]

theorem signed_comm (c : Central₂ G) (u v : G) (a b : Bool) :
    ⁅sgn u a,sgn v b⁆=sgn ⁅u,v⁆ (a==b) := by
  cases a <;> cases b <;> simp [sgn,inv_left c,inv_right c]

theorem swap_step (c : Central₂ G) (g : Nat → G) (a b : Letter) :
    ls g a*ls g b=ls g b*ls g a*cs g ((a.1,b.1),a.2==b.2) := by
  have e := (c (ls g a) (ls g b) (ls g b*ls g a)).eq
  unfold ls cs
  rw [←signed_comm c]
  change ls g a*ls g b=ls g b*ls g a*⁅ls g a,ls g b⁆
  rw [←e,commutatorElement_def]
  group

theorem central_cs (c : Central₂ G) (g : Nat→G) (a : Com) (u : G) : Commute (cs g a) u := by
  rcases a with ⟨⟨i,j⟩,e⟩
  cases e
  · exact (c (g i) (g j) u).inv_left
  · exact c (g i) (g j) u

def place (x : Letter) : List Letter → List Letter × List Com
  | [] => ([x],[])
  | b::t => if x.1≤b.1 then (x::b::t,[]) else
      let (L,C) := place x t
      (b::L,((x.1,b.1),x.2==b.2)::C)

theorem place_sound (c : Central₂ G) (g : Nat→G) (a : Letter) (w : List Letter) :
    ls g a * evalL g w = evalL g (place a w).1 * evalC g (place a w).2 := by
  induction w with
  | nil => simp [place,evalL,evalC]
  | cons b t ih =>
    by_cases x : a.1≤b.1
    · simp [place,x,evalL,evalC,mul_assoc]
    · let z := cs g ((a.1,b.1),a.2==b.2)
      simp only [place,if_neg x,evalL,evalC,List.map_cons,List.prod_cons]
      change ls g a*(ls g b*evalL g t) =
        (ls g b*evalL g (place a t).1)*(z*evalC g (place a t).2)
      have e1 : z*evalL g t=evalL g t*z := (central_cs c g _ _).eq
      have e2 : z*evalC g (place a t).2=evalC g (place a t).2*z :=
        (central_cs c g _ _).eq
      calc
        _ = (ls g b*ls g a)*(z*evalL g t) := by
          rw [←mul_assoc,swap_step c]
          simp only [z,mul_assoc]
        _ = ls g b*((ls g a*evalL g t)*z) := by rw [e1]; simp only [mul_assoc]
        _ = _ := by rw [ih,e2]; simp only [mul_assoc]

def collect : List Letter → List Letter × List Com
  | [] => ([],[])
  | a::w =>
    let (L,C) := collect w
    let (N,E) := place a L
    (N,E++C)

theorem collected (c : Central₂ G) (g : Nat→G) (w : List Letter) :
    evalL g w=evalL g (collect w).1*evalC g (collect w).2 := by
  induction w with
  | nil => simp [evalL,evalC,collect]
  | cons a w ih =>
    change ls g a*evalL g w=_
    simp only [collect,evalC,List.map_append,List.prod_append]
    have h := place_sound c g a (collect w).1
    rw [ih,←mul_assoc,h]
    simp [evalC,mul_assoc]

end RibbonSchreierCollect
#print axioms RibbonSchreierCollect.collected
