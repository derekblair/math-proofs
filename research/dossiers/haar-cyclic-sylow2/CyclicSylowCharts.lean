import Mathlib.Tactic

namespace CyclicSylowCharts

abbrev IVert := ℤ × ℤ × ℤ
abbrev QVert := ℤ × ℤ × ℤ × ℤ

def integralEdge (haar : Bool) (a b : IVert) : Prop :=
  let (s,x,y) := a
  let (t,z,w) := b
  let dx := z-x
  let dy := w-y
  if haar then
    let sign : ℤ := if s=0 then 1 else -1
    s≠t ∧ ((dx=0 ∧ dy=0) ∨ (dx=sign ∧ dy=0) ∨ (dx=0 ∧ dy=sign))
  else if s≠t then dx=0 ∧ dy=0
  else if s=0 then (dx=1 ∨ dx=(-1)) ∧ dy=0
  else dx=0 ∧ (dy=1 ∨ dy=(-1))

instance (haar a b) : Decidable (integralEdge haar a b) := by
  unfold integralEdge
  infer_instance

def finiteEdge (haar : Bool) (p d bmark : ℤ) (a b : QVert) : Prop :=
  let (s,g,x,y) := a
  let (t,h,z,w) := b
  let dx := (z-x)%p
  let dy := (w-y)%p
  let dg := (h-g)%d
  let straight := dx=0 ∧ dy=0 ∧ dg=0
  let X (sign : ℤ) := dx=sign%p ∧ dy=0 ∧ dg=sign%d
  let Y (sign : ℤ) := dx=0 ∧ dy=sign%p ∧ dg=(sign*bmark)%d
  if haar then
    let sign : ℤ := if s=0 then 1 else -1
    s≠t ∧ (straight ∨ X sign ∨ Y sign)
  else if s≠t then straight
  else if s=0 then X 1 ∨ X (-1) else Y 1 ∨ Y (-1)

instance (haar p d bmark a b) : Decidable (finiteEdge haar p d bmark a b) := by
  unfold finiteEdge
  infer_instance

def theta {V : Type} [Inhabited V] [DecidableEq V] (edge : V → V → Prop)
    [DecidableRel edge] (m : ℕ) (p : List (List V)) : Prop :=
  let u := p.head!.head!
  let v := p.head!.getLast!
  p.length=3 ∧
  p.all (fun arm => decide (arm.length=m+1 ∧ arm.head! = u ∧ arm.getLast! = v ∧ arm.IsChain edge))=true ∧
  (u :: v :: p.flatMap (fun arm => arm.tail.dropLast)).Nodup

instance {V : Type} [Inhabited V] [DecidableEq V] (edge : V → V → Prop)
    [DecidableRel edge] (m : ℕ) (p : List (List V)) : Decidable (theta edge m p) := by
  unfold theta
  infer_instance

def barbell {V : Type} [Inhabited V] [DecidableEq V] (edge : V → V → Prop)
    [DecidableRel edge] (m : ℕ) (p : List (List V)) : Prop :=
  let a := p.head!
  let b := p[1]!
  let c := p[2]!
  p.length=3 ∧ a.length=m ∧ c.length=m ∧ b.length=m+1 ∧
  a.IsChain edge ∧ b.IsChain edge ∧ c.IsChain edge ∧ edge a.getLast! a.head! ∧ edge c.getLast! c.head! ∧
  b.head! ∈ a ∧ b.getLast! ∈ c ∧ (a ++ b.tail.dropLast ++ c).Nodup

instance {V : Type} [Inhabited V] [DecidableEq V] (edge : V → V → Prop)
    [DecidableRel edge] (m : ℕ) (p : List (List V)) : Decidable (barbell edge m p) := by
  unfold barbell
  infer_instance

