import Mathlib.Tactic

/-! Kernel checks for 353 literal equal-arm charts over quintic affine square lifts. -/
namespace QuinticAffineSquare
set_option synthInstance.maxSize 1024

abbrev E := ℤ × ℤ × ℤ × ℤ
abbrev Volt := E × E × E
abbrev Phase := ℕ × ℕ × ℕ
abbrev State := ℕ × ℕ × E × E
def zeroE : E := (0, 0, 0, 0)
def addE (x y : E) : E := (x.1+y.1, x.2.1+y.2.1, x.2.2.1+y.2.2.1, x.2.2.2+y.2.2.2)
def negE (x : E) : E := (-x.1, -x.2.1, -x.2.2.1, -x.2.2.2)
def mulRoot (x : E) : E :=
  let (a,b,c,d) := x
  (-d,a-d,b-d,c-d)
def rootMul : ℕ → E → E
  | 0, x => x
  | n+1, x => mulRoot (rootMul n x)

/-! Tags run clockwise, with +2 and +5 the alternate doubled edges. -/
def edgeLabel (i : ℕ) (p : Phase) (z : Volt) : ℕ × ℕ × ℕ × E :=
  match i with
  | 0 => (0,1,0,zeroE) | 1 => (0,1,p.1,z.1) | 2 => (1,2,0,zeroE)
  | 3 => (2,3,0,zeroE) | 4 => (2,3,p.2.1,z.2.1) | _ => (3,0,p.2.2,z.2.2)

def transition (ph : Phase) (A B : Volt) (s : State) (i : ℤ) : Option State :=
  let k := i.natAbs
  if k = 0 ∨ 6 < k then none else
    let (u,v,h,a) := edgeLabel (k-1) ph A
    let b := (edgeLabel (k-1) ph B).2.2.2
    let (n,j,x,y) := s
    if 0 < i then
      if n = u then some (v,(j+h)%5,addE x (rootMul j a),addE y (rootMul j b)) else none
    else
      if n = v then
        let q := (j+5-h)%5
        some (u,q,addE x (negE (rootMul q a)),addE y (negE (rootMul q b)))
      else none

def trace (ph : Phase) (A B : Volt) (s : State) : List ℤ → Option (List State)
  | [] => some [s]
  | i::w => match transition ph A B s i with
    | none => none
    | some t => (trace ph A B t w).map (s :: ·)

def initial : State := (0,0,zeroE,zeroE)

def finiteKey (p z : ℤ) (s : State) : State :=
 let (n,k,a,b) := s
 let scalar (x : E) : E :=
   let (a,b,c,d) := x
   ((a+z*(b+z*(c+z*d))) % p,0,0,0)
 (n,k,scalar a,scalar b)

def finiteVectorKey (p : ℤ) (s : State) : State :=
 let (n,k,a,b) := s
 let poly (x : E) : E :=
   let (a,b,c,d) := x
   (a%p,b%p,c%p,d%p)
 (n,k,poly a,poly b)

def Verify (key : State → State) (p : Phase) (A B : Volt) (w : List (List ℤ)) : Prop :=
  match w.mapM (trace p A B initial) with
  | none => False
  | some bars =>
    let v := key bars.head!.getLast!
    w.length = 3 ∧ (w.head!.length = 8 ∨ w.head!.length = 16 ∨ w.head!.length = 32) ∧
    bars.all (fun arm => decide (arm.length = w.head!.length+1 ∧ key arm.getLast! = v)) = true ∧
    (key initial :: v :: (bars.flatMap (fun arm => arm.tail.dropLast)).map key).Nodup

instance (key p A B w) : Decidable (Verify key p A B w) := by
  unfold Verify
  split <;> infer_instance

set_option maxRecDepth 10000
set_option maxHeartbeats 4000000

