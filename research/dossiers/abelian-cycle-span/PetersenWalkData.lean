def size (j : Fin 15) := (word j).length
def vertex (j : Fin 15) (i : ℕ) : Fin 10 :=
  ((word j)[i % size j]?).getD 0
def pvec (j : Fin 15) (i : ℕ) : V :=
  ((prefixes j)[i]?).getD 0
def etag (j : Fin 15) (i : ℕ) : Fin 15 × Bool :=
  ((indexTable j)[i]?).getD (0,false)
def evec (k : Fin 15) : V := fun c => if c=k then 1 else 0
def base (u v : Fin 10) : Prop := ∃ k : Fin 15, edges k=(u,v) ∨ edges k=(v,u)

set_option maxRecDepth 30000
set_option maxHeartbeats 0

theorem size_ok (j : Fin 15) : size j=8 ∨ size j=16 := by
  fin_cases j <;> decide +kernel

theorem prefix_start (j : Fin 15) : pvec j 0=0 := by
  fin_cases j <;> decide +revert

theorem prefix_end (j : Fin 15) :
    pvec j (size j)=closing j ∨ pvec j (size j)=-(closing j) := by
  fin_cases j <;> decide +revert

def step_ok (j : Fin 15) (i : Fin (size j)) : Prop :=
  let (k,sgn) := etag j i.val
  (if sgn then edges k = (vertex j i.val,vertex j (i.val+1))
          else edges k = (vertex j (i.val+1),vertex j i.val)) ∧
  pvec j (i.val+1)=pvec j i.val+(if sgn then evec k else -(evec k))

instance (j : Fin 15) (i : Fin (size j)) : Decidable (step_ok j i) := by
  unfold step_ok
  infer_instance

theorem steps_complete (j : Fin 15) (i : Fin (size j)) : step_ok j i := by
  fin_cases j <;> revert i <;> decide +revert

def coll_ok (j : Fin 15) (i k : Fin (size j)) : Prop :=
  i ≠ k → vertex j i.val=vertex j k.val →
    pvec j i.val-pvec j k.val ∈ clashes j ∨
    pvec j k.val-pvec j i.val ∈ clashes j

instance (j : Fin 15) (i k : Fin (size j)) : Decidable (coll_ok j i k) := by
  unfold coll_ok
  infer_instance

theorem clashes_complete (j : Fin 15) (i k : Fin (size j)) : coll_ok j i k := by
  fin_cases j <;> revert i k <;> decide +revert

end PetersenWalkData
#print axioms PetersenWalkData.steps_complete
#print axioms PetersenWalkData.clashes_complete
