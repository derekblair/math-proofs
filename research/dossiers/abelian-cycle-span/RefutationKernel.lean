import SpanCriterion
import Mathlib.Tactic

namespace AbelianCycleChart

variable {M W : Type*} [AddCommGroup M] [DecidableEq M]

/-- A finite positive certificate generated by forced-clash branching. At a
node a listed closing vector must follow from the already forced clashes;
every possible collision of that row has its own refutation child. -/
inductive Refutes (rows : Finset W) (close : W → M) (clash : W → Finset M) :
    Finset M → Prop where
  | node {S : Finset M} (w : W) (hw : w ∈ rows)
      (closed : close w ∈ Submodule.span ℤ (S : Set M))
      (branches : ∀ v ∈ clash w, Refutes rows close clash (insert v S)) :
      Refutes rows close clash S

theorem refutes_sound {rows : Finset W} {close : W → M} {clash : W → Finset M}
    {S : Finset M} (cert : Refutes rows close clash S) :
    ∀ P : Submodule ℤ M, Submodule.span ℤ (S : Set M) ≤ P → ¬bad rows close clash P := by
  induction cert with
  | node w hw closed branches IH =>
      intro P le hBad
      obtain ⟨v,hv,mem⟩ := hBad w hw (le closed)
      apply IH v hv P ?_ hBad
      apply Submodule.span_le.mpr
      intro x hx
      rcases Finset.mem_insert.mp hx with rfl|hx
      · exact mem
      · exact le (Submodule.subset_span hx)

theorem refutes_complete {rows : Finset W} {close : W → M} {clash : W → Finset M} :
    ∀ S : Finset M, S ⊆ candidates rows clash →
      (¬ ∃ P : Submodule ℤ M, Submodule.span ℤ (S : Set M) ≤ P ∧ bad rows close clash P) →
      Refutes rows close clash S := by
  classical
  intro S
  let N := (candidates rows clash).card
  have main (n : ℕ) (S : Finset M) (count : N-S.card=n) (sub : S ⊆ candidates rows clash)
      (H : ¬ ∃ P : Submodule ℤ M, Submodule.span ℤ (S : Set M) ≤ P ∧ bad rows close clash P) :
      Refutes rows close clash S := by
    induction n using Nat.strong_induction_on generalizing S with
    | h n ih =>
      let R := Submodule.span ℤ (S : Set M)
      have fail : ¬bad rows close clash R := fun B => H ⟨R,le_rfl,B⟩
      unfold bad at fail
      push Not at fail
      obtain ⟨w,hw,cl,ex⟩ := fail
      apply Refutes.node w hw cl
      intro v hv
      have notMem : v ∉ S := fun h => ex v hv (Submodule.subset_span h)
      have good : v ∈ candidates rows clash := Finset.mem_biUnion.mpr ⟨w,hw,hv⟩
      have sub' : insert v S ⊆ candidates rows clash := Finset.insert_subset_iff.mpr ⟨good,sub⟩
      have le := Finset.card_le_card sub'
      change (insert v S).card ≤ N at le
      have add := Finset.card_insert_of_notMem notMem
      refine ih (N-(insert v S).card) (by omega) _ rfl sub' ?_
      rintro ⟨P,le,h⟩
      apply H
      refine ⟨P, (Submodule.span_mono ?_).trans le,h⟩
      intro x hx
      exact Finset.mem_insert_of_mem hx
  exact main (N-S.card) S rfl

theorem refutation_iff {rows : Finset W} {close : W → M} {clash : W → Finset M} :
    Refutes rows close clash ∅ ↔ ¬∃ P : Submodule ℤ M, bad rows close clash P := by
  constructor
  · intro H
    rintro ⟨P,B⟩
    apply refutes_sound H P _ B
    simp
  · intro H
    apply refutes_complete ∅ (Finset.empty_subset _)
    rintro ⟨P,_,B⟩
    exact H ⟨P,B⟩

end AbelianCycleChart
#print axioms AbelianCycleChart.refutation_iff
