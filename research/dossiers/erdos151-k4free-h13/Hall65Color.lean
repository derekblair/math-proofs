def adjBool (a b : Fin 65) : Bool := rows[a.val]!.testBit b.val
def Adj (a b : Fin 65) : Prop := adjBool a b = true
def color (a b : Fin 65) : Bool := red[a.val]!.testBit b.val

set_option maxHeartbeats 0
set_option maxRecDepth 10000

theorem color_symmetric : ∀ a b : Fin 65, color a b=color b a := by decide +kernel

def safeRow (a : Fin 65) : Bool :=
  (List.finRange 65).all fun b => !adjBool a b ||
    (List.finRange 65).all fun c => !adjBool b c || !adjBool c a ||
      !(decide (color a b = color b c) && decide (color b c = color c a))

theorem safe_computed : ∀ a : Fin 65, safeRow a=true := by decide +kernel

theorem not_ramsey : ¬ BikovLocal.Ramsey Adj := by
  intro h
  apply h color color_symmetric
  intro a b c ab bc ca mono
  have x := (List.all_eq_true.mp (safe_computed a)) b (List.mem_finRange b)
  change adjBool a b = true at ab
  simp only [ab,Bool.not_true,Bool.false_or] at x
  have y := (List.all_eq_true.mp x) c (List.mem_finRange c)
  change adjBool b c = true at bc
  change adjBool c a = true at ca
  simp [bc,ca,mono.1,mono.2] at y

#print axioms not_ramsey
end Erdos151H13.Hall65
