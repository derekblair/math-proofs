def data (t : Fin 4) (i : ℕ) : Row := (raw t)[i]!
theorem starts (t : Fin 4) : data t 0=base := by revert t; decide
theorem steps (t : Fin 4) (i : Fin 64) :
    (label (word t) i.val=2 → range4 (data t i.val).i) ∧
    data t (i.val+1)=move (decide (i.val%2=0)) (label (word t) i.val) (data t i.val) := by
  revert t i
  decide

def tail (p : Row) : Coeff := (p.u,p.v,p.a,p.b,p.d)
def check (t : Fin 4) (i j : Fin 64) : Prop :=
  let D := diff (data t i.val) (data t j.val)
  j.val ≤ i.val ∨ i.val%2≠j.val%2 ∨ D.i%3≠0 ∨ D.j%3≠0 ∨
    (D.i=0 ∧ D.j=0 ∧ D.c%3≠0) ∨
    (D.i=0 ∧ D.j=0 ∧ D.c=0 ∧ tail D ∈ critical t)
instance (t : Fin 4) (i j : Fin 64) : Decidable (check t i j) := by unfold check; infer_instance
