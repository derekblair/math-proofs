def dirs (t : Fin 4) : Fin 4 → Vec := ![D0,D1,D2,D3] t

def matchesDir (ds : Fin 4 → Vec) (u v : ℤ) : Prop :=
  ∃ i : Fin 4, (u=(ds i).1 ∧ v=(ds i).2) ∨ (u=-(ds i).1 ∧ v=-(ds i).2)
instance (ds : Fin 4 → Vec) (u v : ℤ) : Decidable (matchesDir ds u v) := by unfold matchesDir; infer_instance

def small2 (v : ℤ) : Prop := v.natAbs=1 ∨ v.natAbs=2
instance (v : ℤ) : Decidable (small2 v) := by unfold small2; infer_instance

def pair (t : Fin 4) (i j : Fin 64) : Prop :=
  let p := rowsW t i.val
  let q := rowsW t j.val
  let u := q.1-p.1
  let v := q.2.1-p.2.1
  let c := q.2.2.1-p.2.2.1
  let a := q.2.2.2.1-p.2.2.2.1
  let b := q.2.2.2.2-p.2.2.2.2
  i=j ∨ i.val%2≠ j.val%2 ∨ small2 u ∨ small2 v ∨
    (u=0 ∧ v=0 ∧ small2 c) ∨
    (u=0 ∧ v=0 ∧ c=0 ∧ matchesDir (dirs t) a b)
instance (t : Fin 4) (i j : Fin 64) : Decidable (pair t i j) := by unfold pair; infer_instance

theorem concat (t : Fin 4) : W t = A t ++ B t ++ (A t).reverse ++ (B t).reverse := by revert t; decide

theorem A_len (t : Fin 4) : (A t).length=12 := by revert t; decide
theorem B_len (t : Fin 4) : (B t).length=20 := by revert t; decide
theorem W_len (t : Fin 4) : (W t).length=64 := by revert t; decide

theorem W_good (t : Fin 4) : HaarSharpCore.good (W t)=true := by revert t; decide
theorem A_zero (t : Fin 4) : rowsA t 0 = (0,0,0,0,0) := by revert t; decide

set_option maxRecDepth 14000 in
set_option maxHeartbeats 2000000 in
theorem A_steps (t : Fin 4) (i : Fin 12) :
    (label (A t) i.val=2 → Range (rowsA t i.val).1) ∧
    rowsA t (i.val+1) = move (decide (i.val%2=0)) (label (A t) i.val) (rowsA t i.val) := by
  revert t i
  decide

theorem B_zero (t : Fin 4) : rowsB t 0 = (0,0,0,0,0) := by revert t; decide

set_option maxRecDepth 14000 in
set_option maxHeartbeats 2000000 in
theorem B_steps (t : Fin 4) (i : Fin 20) :
    (label (B t) i.val=2 → Range (rowsB t i.val).1) ∧
    rowsB t (i.val+1) = move (decide (i.val%2=0)) (label (B t) i.val) (rowsB t i.val) := by
  revert t i
  decide

theorem W_zero (t : Fin 4) : rowsW t 0 = (0,0,0,0,0) := by revert t; decide

set_option maxRecDepth 14000 in
