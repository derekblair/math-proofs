theorem W_steps (t : Fin 4) (i : Fin 64) :
    (label (W t) i.val=2 → Range (rowsW t i.val).1) ∧
    rowsW t (i.val+1) = move (decide (i.val%2=0)) (label (W t) i.val) (rowsW t i.val) := by
  revert t i
  decide

theorem A_grade (t : Fin 4) :
    (rowsA t 12).1=0 ∧ (rowsA t 12).2.1=0 ∧ (rowsA t 12).2.2.1=0 := by
  revert t
  decide

theorem B_grade (t : Fin 4) :
    (rowsB t 20).1=0 ∧ (rowsB t 20).2.1=0 ∧ (rowsB t 20).2.2.1=0 := by
