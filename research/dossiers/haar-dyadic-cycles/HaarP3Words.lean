theorem A_len (t : Fin 5) : (A t).length=12 := by revert t; decide
theorem A_zero (t : Fin 5) : rowsA t 0=(0,0,0,0,0) := by revert t; decide
set_option maxRecDepth 20000 in
theorem A_steps (t : Fin 5) (i : Fin 12) :
    (label (A t) i.val=2 → Range (rowsA t i.val).1) ∧
    rowsA t (i.val+1)=move (decide (i.val%2=0)) (label (A t) i.val) (rowsA t i.val) := by
  revert t i
  decide
theorem A_grade (t : Fin 5) :
    (rowsA t 12).1=0 ∧ (rowsA t 12).2.1=0 ∧ (rowsA t 12).2.2.1=0 := by revert t; decide

theorem A_tail (x y : G) (t : Fin 5) : prodFrom x y 0 (A t) ∈ L G 2 := by
  apply tail_word x y (A t) (rowsA t) (A_zero t)
  · intro i hi
    rw [A_len] at hi
    exact A_steps t ⟨i,hi⟩
  · rw [A_len]; exact A_grade t
