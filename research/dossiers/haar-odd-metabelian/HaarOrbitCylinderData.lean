def D (i : Nat) : Node := payload[i]!

private theorem ok0 : valid D 0 := by decide +kernel
private theorem ok1 : valid D 1 := by decide +kernel
private theorem ok2 : valid D 2 := by decide +kernel
private theorem ok3 : valid D 3 := by decide +kernel
private theorem ok4 : valid D 4 := by decide +kernel
private theorem ok5 : valid D 5 := by decide +kernel
private theorem ok6 : valid D 6 := by decide +kernel
theorem complete (i : Nat) (_hi : i ≤ 6) : valid D i := by
  by_cases h0_7 : i < 3
  · by_cases h0_3 : i < 1
    · have e : i = 0 := by omega
      subst i
      exact ok0
    · by_cases h1_3 : i < 2
      · have e : i = 1 := by omega
        subst i
        exact ok1
      · have e : i = 2 := by omega
        subst i
        exact ok2
  · by_cases h3_7 : i < 5
    · by_cases h3_5 : i < 4
      · have e : i = 3 := by omega
        subst i
        exact ok3
      · have e : i = 4 := by omega
        subst i
        exact ok4
    · by_cases h5_7 : i < 6
      · have e : i = 5 := by omega
        subst i
        exact ok5
      · have e : i = 6 := by omega
        subst i
        exact ok6
theorem root_empty : (D 6).rels = [] := by decide +kernel
variable {A : Type*} [AddCommGroup A]
theorem any_voltage (φ : V →+ A) (noTwo : ∀ a : A, a+a=0 → a=0)
    (safe : ∀ i ≤ 6, ∀ j : Fin (D i).branches.length,
      φ (D i).branches[j].diff=0 → Vanish φ (D i).branches[j].added) :
    ∃ n, n ∈ [4,8,16,32] ∧ HasCycle φ n :=
  dag_sound φ noTwo D 6 complete safe root_empty
end HaarOrbitCylinderData
#print axioms HaarOrbitCylinderData.any_voltage
