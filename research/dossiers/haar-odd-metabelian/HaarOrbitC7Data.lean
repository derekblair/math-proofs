theorem complete (i : Nat) (_hi : i ≤ 11) : valid D i := by
  by_cases h0_12 : i < 6
  · by_cases h0_6 : i < 3
    · by_cases h0_3 : i < 1
      · have e : i = 0 := by omega
        subst i
        exact ok0
      · by_cases h1_3 : i < 2
        · have e : i = 1 := by omega
          subst i
          exact ok1
        · have e : i = 2 := by omega
          subst i
          exact ok2
    · by_cases h3_6 : i < 4
      · have e : i = 3 := by omega
        subst i
        exact ok3
      · by_cases h4_6 : i < 5
        · have e : i = 4 := by omega
          subst i
          exact ok4
        · have e : i = 5 := by omega
          subst i
          exact ok5
  · by_cases h6_12 : i < 9
    · by_cases h6_9 : i < 7
      · have e : i = 6 := by omega
        subst i
        exact ok6
      · by_cases h7_9 : i < 8
        · have e : i = 7 := by omega
          subst i
          exact ok7
        · have e : i = 8 := by omega
          subst i
          exact ok8
    · by_cases h9_12 : i < 10
      · have e : i = 9 := by omega
        subst i
        exact ok9
      · by_cases h10_12 : i < 11
        · have e : i = 10 := by omega
          subst i
          exact ok10
        · have e : i = 11 := by omega
          subst i
          exact ok11
theorem root_empty : (D 11).rels = [] := by decide +kernel
variable {A : Type*} [AddCommGroup A]
theorem any_voltage (φ : V →+ A) (noTwo : ∀ a : A, a+a=0 → a=0)
    (safe : ∀ i ≤ 11, ∀ j : Fin (D i).branches.length,
      φ (D i).branches[j].diff=0 → Vanish φ (D i).branches[j].added) :
    ∃ n, n ∈ [4,8,16,32] ∧ HasCycle φ n :=
  dag_sound φ noTwo D 11 complete safe root_empty
end HaarOrbitC7Data
