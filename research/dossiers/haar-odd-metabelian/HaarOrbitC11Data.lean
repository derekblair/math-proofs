def D (i : Nat) : Node := payload[i]!

private theorem ok0 : valid D 0 := by decide +kernel
private theorem ok1 : valid D 1 := by decide +kernel
private theorem ok2 : valid D 2 := by decide +kernel
private theorem ok3 : valid D 3 := by decide +kernel
private theorem ok4 : valid D 4 := by decide +kernel
private theorem ok5 : valid D 5 := by decide +kernel
private theorem ok6 : valid D 6 := by decide +kernel
private theorem ok7 : valid D 7 := by decide +kernel
theorem complete (i : Nat) (_hi : i ≤ 7) : valid D i := by
  by_cases h0_8 : i < 4
  · by_cases h0_4 : i < 2
    · by_cases h0_2 : i < 1
      · have e : i = 0 := by omega
        subst i
        exact ok0
      · have e : i = 1 := by omega
        subst i
        exact ok1
    · by_cases h2_4 : i < 3
      · have e : i = 2 := by omega
        subst i
        exact ok2
      · have e : i = 3 := by omega
        subst i
        exact ok3
  · by_cases h4_8 : i < 6
    · by_cases h4_6 : i < 5
      · have e : i = 4 := by omega
        subst i
        exact ok4
      · have e : i = 5 := by omega
        subst i
        exact ok5
    · by_cases h6_8 : i < 7
      · have e : i = 6 := by omega
        subst i
        exact ok6
      · have e : i = 7 := by omega
        subst i
        exact ok7
theorem root_empty : (D 7).rels = [] := by decide +kernel
variable {A : Type*} [AddCommGroup A]
theorem any_voltage (φ : V →+ A) (noTwo : ∀ a : A, a+a=0 → a=0)
    (safe : ∀ i ≤ 7, ∀ j : Fin (D i).branches.length,
      φ (D i).branches[j].diff=0 → Vanish φ (D i).branches[j].added) :
    ∃ n, n ∈ [4,8,16,32] ∧ HasCycle φ n :=
  dag_sound φ noTwo D 7 complete safe root_empty
end HaarOrbitC11Data
#print axioms HaarOrbitC11Data.any_voltage
