import BK73Core
/-
  Computational core for: every bridgeless graph on 7 vertices with ≥ 11 edges
  has an orientation of diameter ≤ 4 (Boriboon–Kittipassorn, arXiv:2508.17569,
  Conjecture 4 at (n,d) = (7,4) predicts 12). Kernel-evaluated only.
-/
namespace BK73

def reach4 (os : List Nat) (u : Nat) : Nat := step os (step os (step os (step os (2 ^ u))))

def goodOs4 (os : List Nat) : Bool := (List.range 7).all (fun u => reach4 os u == 127)

def good4 (m t : Nat) : Bool := goodOs4 ((List.range 7).map (orow m t))

